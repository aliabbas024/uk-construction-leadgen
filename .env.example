# Companies House API key. Keep this secret; never commit .env.
COMPANIES_HOUSE_API_KEY=replace_with_your_api_key

# Required only when hosting the remote MCP server.
MCP_API_KEY=replace_with_a_long_random_secret

# Optional request pacing. 0.55 seconds is a conservative starting point.
CH_REQUEST_DELAY=0.55

# Optional: set to 1 to include adjacent architecture/engineering SIC codes.
INCLUDE_ADJACENT_SIC=0
